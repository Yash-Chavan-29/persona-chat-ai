# Gemini API Key — get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB persistence directory (relative or absolute)
CHROMA_PERSIST_DIR=./data/vector_db

# The WhatsApp display name of the person to impersonate
PERSONA_NAME=TargetFriendName

# Development or production
APP_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
